# ==== 数据库（docker-compose 与 app 共用）====
POSTGRES_USER=xagent
POSTGRES_PASSWORD=xagent
POSTGRES_DB=xagent
POSTGRES_PORT=5432

# 应用连接串（psycopg3，异步；与上方 POSTGRES_* 保持一致）
DATABASE_URL=postgresql+psycopg://xagent:xagent@localhost:5432/xagent

# LangGraph Checkpointer 连接串（libpq conninfo，无 +psycopg 方言后缀）
# 留空则自动由 DATABASE_URL 推导；V1 指向同一个库即可，职责与连接池独立
LANGGRAPH_CHECKPOINT_DATABASE_URL=

# ==== LLM（OpenAI 兼容接口，base_url 可指向任意兼容服务）====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# ==== X API v2 ====
X_API_BASE_URL=https://api.x.com
# search 端点所需的 app-only Bearer token（开发者门户获取）
X_API_BEARER_TOKEN=

# X OAuth 1.0a 凭据（Publish 阶段使用；写接口必须用 user context，Bearer token 不能发帖）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
